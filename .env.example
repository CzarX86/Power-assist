# Power Assist Configuration

# Application Settings
APP_NAME=Power Assist
APP_VERSION=0.1.0
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# File Upload Settings
MAX_UPLOAD_SIZE=104857600  # 100 MB in bytes
UPLOAD_DIR=uploads
PROCESSED_DIR=processed

# Agno Framework Settings
AGNO_MODEL=gpt-4
AGNO_TEMPERATURE=0.7
AGNO_MAX_TOKENS=2000

# Document Processing Settings
ENABLE_OCR=true
EXTRACT_IMAGES=true
PRESERVE_LAYOUT=true
